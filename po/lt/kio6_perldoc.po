#: perldoc.cpp:72
#, kde-format
msgid ""
"<html><head><title>No page requested</title><body>No page was requested.  "
"You can search for:<ul><li>functions using perldoc:/functions/foo</li>\n"
"\n"
"<li>faq entries using perldoc:/faq/search_terms</li><li>All other perldoc "
"documents using the name of the document, like<ul><li><a href='perldoc:/"
"perlreftut'>perldoc:/perlreftut</a></li><li>or <a href='perldoc:/Net::"
"HTTP'>perldoc:/Net::HTTP</a></li></ul></li></ul>\n"
"\n"
"</body></html>\n"
msgstr ""
"<html><head><title>Neužklausta jokio puslapio</title><body>Nebuvo užklausta "
"jokio puslapio.  Galite ieškoti:<ul><li>funkcijų naudodami perldoc:/"
"functions/kažkas</li>\n"
"\n"
"<li>dažnai užduodamų klausimų įrašų naudodami perldoc:/faq/ieškomi_žodžiai</"
"li><li>Visų kitų perldoc dokumentų, naudojant dokumento pavadinimą, "
"pavyzdžiui,<ul><li><a href='perldoc:/perlreftut'>perldoc:/perlreftut</a></"
"li><li>arba <a href='perldoc:/Net::HTTP'>perldoc:/Net::HTTP</a></li></ul></"
"li></ul>\n"
"\n"
"</body></html>\n"

#: perldoc.cpp:91
#, kde-format
msgid ""
"<html><head><title>No documentation for %1</title><body>Unable to find "
"documentation for <b>%2</b></body></html>\n"
msgstr ""
"<html><head><title>Nėra dokumentacijos, skirtos %1</title><body>Nepavyko "
"rasti dokumentaciją, skirtą <b>%2</b></body></html>\n"

